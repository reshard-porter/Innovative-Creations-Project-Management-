# Works immediately with SQLite. Copy this file to .env to customize.
APP_ENV=development
DATABASE_BACKEND=sqlite
PORT=5000
APP_BASE_URL=http://127.0.0.1:5000

# Leave blank locally to generate a persistent key in instance/secret.key.
# For hosting, generate a new key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional MongoDB: set DATABASE_BACKEND=mongo and include a database name here.
MONGO_URI=mongodb://localhost:27017/Users

# Local recovery links are printed in the running app's terminal.
AUTH_MAIL_MODE=console
# For hosted email recovery, set AUTH_MAIL_MODE=smtp and configure these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
